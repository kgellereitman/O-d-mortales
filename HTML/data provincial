/* ---------- DATA PROVINCIAL ---------- */
.province-page { min-height: 100vh; }
.province-page .province-header { padding-bottom: 24px; }
.province-page h1 { margin-bottom: 0; }
.province-main { max-width: 640px; margin: 0 auto; padding-bottom: 72px; }
.province-card { position: relative; padding: clamp(22px, 4vw, 34px); border: 4px solid var(--blue); border-radius: 14px; background: #fff; box-shadow: 4px 4px 0 var(--ink); }
.province-close { position: absolute; top: 8px; left: 12px; display: grid; width: 34px; height: 34px; place-items: center; border-radius: 50%; color: var(--ink); text-decoration: none; font-size: 1.7rem; line-height: 1; }
.province-close:hover, .province-close:focus-visible { background: var(--yellow); outline: none; }
.province-head { display: flex; align-items: center; gap: clamp(16px, 4vw, 28px); margin: 22px 0 26px; }
.province-photo { flex: 0 0 auto; width: clamp(76px, 20vw, 104px); aspect-ratio: 1; border: 1px solid var(--ink); border-radius: 50%; background: var(--panel); }
.province-data { display: grid; gap: 10px; min-width: 0; margin: 0; }
.province-data dt { color: #5f6268; font-size: .82rem; }
.province-data dd { margin: 1px 0 0; font-size: clamp(1.05rem, 2.4vw, 1.3rem); font-weight: 700; line-height: 1.15; }
.province-block { padding-top: 20px; border-top: 1px solid #d8d9d8; }
.province-block + .province-block { margin-top: 20px; }
.province-block h2 { display: flex; align-items: center; gap: 9px; margin: 0 0 12px; font-size: clamp(1.2rem, 2.4vw, 1.5rem); }
.info-button { display: grid; width: 24px; height: 24px; place-items: center; padding: 0; border: 1px solid var(--ink); border-radius: 50%; color: var(--ink); background: var(--blue); font-size: .8rem; font-style: italic; font-weight: 700; cursor: pointer; }
.info-button:hover, .info-button:focus-visible, .info-button[aria-expanded="true"] { background: var(--yellow); outline: none; }
.info-note { margin: 0 0 14px; padding: 11px 14px; border-left: 4px solid var(--blue); background: var(--paper); font-size: .95rem; line-height: 1.4; }
.legislators { display: grid; gap: 8px; margin: 0; padding-left: 26px; }
.legislators li { padding-left: 4px; color: #303238; line-height: 1.35; }
.legislators li::marker { color: var(--ink); font-weight: 700; }
.legislators-cols { display: block; column-count: 2; column-gap: 28px; }
.legislators-cols li { margin-bottom: 8px; break-inside: avoid; }
.province-page footer { padding-top: 0; }

@media (max-width: 620px) {
  .province-main { padding-bottom: 48px; }
  .province-card { padding: 20px 16px; }
  .province-head { margin: 26px 0 22px; }
  .legislators-cols { column-gap: 14px; }
}